{
  "name": "recode",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo build --filter @recode/ai --filter @recode/agent && bun --watch packages/cli/src/main.ts",
    "start": "turbo build --filter @recode/ai --filter @recode/agent && bun packages/cli/src/main.ts",
    "bundle": "bun build --compile --target=bun-windows-x64 packages/cli/src/main.ts --outfile recode.exe --define \"process.env.NODE_ENV='production'\"",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "turbo": "^2.10.2",
    "typescript": "^5.8.3"
  }
}
